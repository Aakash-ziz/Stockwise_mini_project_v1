# Server configuration
PORT=5000
NODE_ENV=development

# Database connection URL (MySQL schema default)
DATABASE_URL=mysql://root:password@localhost:3306/stockwise_db

# Logging configurations
LOG_LEVEL=info

# CORS configurations (comma-separated origins or * for open development)
CORS_ORIGIN=http://localhost:5173

# Rate limit settings (per client ip window)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes in milliseconds
